rules_version = '2';

// Slices #5 + #6 + #7 + #8 + #9 — users, tax form library, client
// CRUD, attach-form-to-client, status workflow + audit history.
//
// Admin (custom-claim role=admin) can read/write all users/{uid} documents.
// Authenticated bookkeeper + admin can also LIST users, so client
// management pages can populate the bookkeeper Select.
// Authenticated non-admin non-bookkeeper can still read their own
// profile doc only. Self-update is permitted so a future own-profile
// editor stays in rules.
//
// For taxForms/{formId}: any authenticated user can read. Create + update
// permitted for admin + bookkeeper. Delete is admin-only.
//
// For clients/{clientId} (slice #7): any signed-in user can read
// non-archived rows; admins can read archived rows too. Create + update
// (including archive/restore status changes) is permitted for
// admin + bookkeeper. Hard delete is admin-only.
//
// For clientFormTasks/{taskId} (slice #8 + #9): authorised actors
// (admin OR the assigned bookkeeper) can update. The shape of the
// update must be one of:
//   * legal forward status transition (status updates only — slices
//     #9 enforces pending→ready→submitted→done; archive is the
//     next-step handled by slice #10)
//   * notes-only or updatedAt-only bumps (no status change) from
//     any status
//   * free editing while the task is still 'pending' (slice #8
//     contract — EditTaskDialog rewrites taxFormId / frequency /
//     period / deadline etc. while status remains 'pending')
//
// taskStatusHistory/{historyId} (slice #9) is append-only: anyone
// with admin or bookkeeper role can create; reads are limited to the
// assigned bookkeeper of the related task (and admins / bookkeepers);
// update + delete are denied for everyone (audit log invariant).
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers — local to this rules file. The `let` expressions
    // make the conditional below readable.
    function isLegalForwardStatusTransition(from, to) {
      return (from == "pending" && to == "ready_to_file")
          || (from == "ready_to_file" && to == "submitted")
          || (from == "submitted" && to == "done");
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.token.role in ["admin", "bookkeeper"]);
      allow create: if request.auth != null
        && request.auth.token.role == "admin";
      allow update: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.token.role == "admin");
      allow delete: if request.auth != null
        && request.auth.token.role == "admin";
    }

    match /taxForms/{formId} {
      // Listing is required by the TaxFormsPage onSnapshot listener, so
      // grant list to any signed-in user. get is also implicitly covered
      // by the read rule below.
      allow list: if request.auth != null;
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.role in ["admin", "bookkeeper"];
      allow delete: if request.auth != null
        && request.auth.token.role == "admin";
    }

    match /clients/{clientId} {
      // List/get for any signed-in user, unless the doc is archived —
      // archived clients are admin-only for read so the default
      // active list stays clean for non-admins.
      allow list: if request.auth != null;
      allow read: if request.auth != null
        && (resource.data.status != "archived"
            || request.auth.token.role == "admin");
      // Create + update covers archive/restore (status changes).
      allow create, update: if request.auth != null
        && request.auth.token.role in ["admin", "bookkeeper"];
      allow delete: if request.auth != null
        && request.auth.token.role == "admin";
    }

    // clientFormTasks/{taskId} — slice #8 + #9.
    // Any signed-in user can read non-archived tasks; admins can read
    // archived tasks too (slice #15 owns the archive page).
    // Create is admin+bookkeeper. Delete requires the task to
    // be pending AND the actor to be the assigned bookkeeper, OR admin.
    // (PRD story 29: edit/remove only while pending.)
    // Update (slice #9) authorises admins fully, and the assigned
    // bookkeeper under three shapes (see header comment):
    //   * free editing of a task that BOTH stays in 'pending' AND
    //     touches any field other than status (status must stay
    //     'pending' — the workflow owns status movement)
    //   * legal forward status transition
    //   * notes-only / updatedAt-only bumps from any status
    match /clientFormTasks/{taskId} {
      allow read: if request.auth != null
        && (resource == null
            || resource.data.archived == false
            || request.auth.token.role == "admin");
      allow create: if request.auth != null
        && request.auth.token.role in ["admin", "bookkeeper"];
      allow update: if request.auth != null
        && (request.auth.token.role == "admin"
            || request.auth.uid == resource.data.assignedBookkeeperId)
        && (
          // Admin: no shape constraint.
          request.auth.token.role == "admin"
          // Bookkeeper, pending task whose status stays pending:
          // free editing (slice #8 EditTaskDialog rewrites
          // taxFormId / frequency / period / deadline while keeping
          // status = 'pending').
          || (request.auth.uid == resource.data.assignedBookkeeperId
              && resource.data.status == "pending"
              && request.resource.data.status == "pending")
          // Legal forward status transition (slice #9).
          || isLegalForwardStatusTransition(resource.data.status, request.resource.data.status)
          // Notes-only / updatedAt-only bumps (slice #9).
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notes", "updatedAt"])
        );
      allow delete: if request.auth != null
        && (request.auth.token.role == "admin"
            || (request.auth.uid == resource.data.assignedBookkeeperId
                && resource.data.status == "pending"));
    }

    // taskStatusHistory/{historyId} — slice #9 audit log. Append-only.
    // Reads are gated on the related clientFormTask being assigned to
    // the requesting user, OR the requester being admin/bookkeeper
    // (so admin screens can show the log). Create is admin+bookkeeper;
    // update + delete are denied (tamper-evidence requirement).
    match /taskStatusHistory/{historyId} {
      allow read: if request.auth != null
        && (resource == null
            || get(/databases/$(database)/documents/clientFormTasks/$(resource.data.taskId)).data.assignedBookkeeperId == request.auth.uid
            || request.auth.token.role == "admin");
      allow create: if request.auth != null
        && request.auth.token.role in ["admin", "bookkeeper"];
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}