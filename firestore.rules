rules_version = '2';

// Slices #5 (users), #4 (taxForms), #7 (clients), #8 + #9
// (clientFormTasks / taskStatusHistory), #10 (archive), #15
// (archive page), and #17 (this file: tightened role × collection
// matrix). This is the consolidated, helpers-based version that
// replaces the inline-conditional shape from the per-slice PRs.
//
// Role matrix (see docs/issues/0016-rules-hardening.md and the PRD):
//
//   ┌─────────────────┬────────┬────────────┬──────────────┐
//   │ collection      │ admin  │ bookkeeper │ staff        │
//   ├─────────────────┼────────┼────────────┼──────────────┤
//   │ users           │ RW all │ R own/list │ R own        │
//   │ taxForms        │ RW all │ R + W      │ R            │
//   │ clients         │ RW all │ R + W      │ R (active)   │
//   │ clientFormTasks │ RW all │ R + W(own) │ R + W(notes) │
//   │   ├ encoderNotes│ RW all │ R + W(own) │ R + W(own)   │
//   │ taskStatusHist. │ R+W*   │ R + W(own) │ R own        │
//   │ birHolidays     │ RW all │ R          │ R            │
//   └─────────────────┴────────┴────────────┴──────────────┘
//
//   * taskStatusHistory is append-only (no update/delete for anyone).
//   Archived rows (per collection: clientFormTasks, clients) are
//   readable by anyone for active, admin-only for archived.
//   Writes to archived clientFormTasks rows are admin-only.
//
// All helpers below are local to this file. They take a `request` /
// `resource` pair implicitly via the rule expression they sit inside.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────
    //
    // These intentionally accept the request/resource implicitly
    // so the call sites stay compact and read like prose. Every
    // helper is named per the issue brief.

    function isAdmin() {
      return request.auth != null
          && request.auth.token.role == "admin";
    }
    function isBookkeeper() {
      return request.auth != null
          && request.auth.token.role == "bookkeeper";
    }
    function isStaff() {
      return request.auth != null
          && request.auth.token.role == "staff";
    }
    // A signed-in user with ANY of the three roles. Used to gate
    // collection-level reads (where we want admins, bookkeepers, and
    // staff all to be able to read the basic data).
    function isAnyRole() {
      return isAdmin() || isBookkeeper() || isStaff();
    }

    // True iff the caller is the assigned bookkeeper for this task.
    // Reads `resource.data.assignedBookkeeperId` directly; callers
    // must ensure `resource` is non-null (the rules below gate reads
    // through `isAdmin() || ...` patterns that include a null check).
    function isAssignedTo() {
      return request.auth != null
          && request.auth.uid == resource.data.assignedBookkeeperId;
    }

    // True iff the document is in the archived state. Two source-of-
    // truth fields exist: `archived` (boolean) and `status` ==
    // "archived". A row is "archived" if EITHER is set.
    function isArchived() {
      return resource.data.archived == true
          || resource.data.status == "archived";
    }

    // Immutability guard for `taskStatusHistory`. Always returns
    // false on update/delete, regardless of role. (The rule body
    // also enforces `allow update, delete: if false` — this helper
    // is kept here for symmetry / future use.)
    function isImmutable() {
      return false;
    }

    // Status transition gate (slice #9). The forward workflow is
    // pending → ready_to_file → submitted → done. Archive is NOT
    // a forward transition here; it goes through the archiveTask
    // callable (slice #10) which uses the Admin SDK.
    function isLegalForwardStatus(from, to) {
      return (from == "pending" && to == "ready_to_file")
          || (from == "ready_to_file" && to == "submitted")
          || (from == "submitted" && to == "done");
    }

    // Slice #10: detect a client-direct attempt to flip a task into
    // the archived state. The archiveTask callable owns that
    // transition via Admin SDK; this predicate catches and rejects
    // client-side smuggling.
    //
    // We use `request.resource.data.status` and `.archived` only
    // when those KEYS are present in the request, because an
    // `updateDoc`-style patch (e.g. a notes-only staff update) does
    // not include unchanged fields in the request payload. The
    // rules engine itself fills in the merged post-image, so when
    // the key IS present, comparing it to the merged value is
    // safe.
    function entersArchivedState() {
      return ('status' in request.resource.data
              && request.resource.data.status == "archived"
              && (!('status' in resource.data)
                  || resource.data.status != "archived"))
          || ('archived' in request.resource.data
              && request.resource.data.archived == true
              && (!('archived' in resource.data)
                  || resource.data.archived != true));
    }

    // Staff write allowlist on clientFormTasks: `notes` only, and
    // the `updatedAt` server timestamp that the client SDK writes
    // alongside every update. Any other field change is denied.
    function isStaffNotesOnlyChange() {
      return isStaff()
          && request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(["notes", "updatedAt"]);
    }

    // Staff write allowlist for the `encoderNotes` subcollection:
    // any fields on a doc inside that subcollection. (Subcollection
    // rules apply to docs at /clientFormTasks/{taskId}/encoderNotes/
    // {noteId}.) This helper is used in the nested match block
    // below; it relies on the outer task context.
    function isStaffEncoderNoteWrite() {
      return isStaff();
      // Note: there is no per-staff assignment check here — staff
      // may add encoder notes to ANY task. Tighter scope can be
      // added by comparing the outer task's assignedBookkeeperId
      // to a `staffMappings/{uid}` doc, but that is out of scope
      // for this slice.
    }

    // ─── /users/{userId} ─────────────────────────────────────────
    //
    // Reads:
    //   - self (any auth): R self
    //   - admin / bookkeeper: R all (listing needed for the
    //     bookkeeper selector in Clients / Users screens)
    //   - staff: own doc only
    // Writes:
    //   - admin: create / update / delete anyone
    //   - self: update own (e.g. own-profile editor future)
    //   - others: denied
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || isAdmin()
            || isBookkeeper());
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // ─── /taxForms/{formId} ──────────────────────────────────────
    //
    // Reads: any signed-in user (list + get).
    // Writes: admin + bookkeeper. Delete admin-only.
    match /taxForms/{formId} {
      allow read: if request.auth != null;
      allow list:  if request.auth != null;
      allow create, update: if isAdmin() || isBookkeeper();
      allow delete: if isAdmin();
    }

    // ─── /clients/{clientId} ─────────────────────────────────────
    //
    // Reads: any signed-in user can read ACTIVE rows; admins can
    // also read archived rows (slice #15 archive page).
    // Writes: admin + bookkeeper (incl. archive / restore flips).
    // Delete: admin only.
    match /clients/{clientId} {
      allow read: if request.auth != null
        && (resource == null
            || resource.data.status != "archived"
            || isAdmin());
      allow list: if request.auth != null;
      allow create, update: if isAdmin() || isBookkeeper();
      allow delete: if isAdmin();
    }

    // ─── /clientFormTasks/{taskId} ───────────────────────────────
    //
    // Slice #8 + #9 + #10 + #16 + #17.
    //
    // Read: any signed-in user for active tasks; admin (and the
    //       assigned bookkeeper) for archived.
    // Create: admin + bookkeeper.
    // Update: admin (full); bookkeeper ONLY if (a) the row remains
    //         in 'pending' and they free-edit any non-status field,
    //         OR (b) the update is a legal forward status
    //         transition, OR (c) the update is notes-only /
    //         updatedAt-only. Archive is NOT a legal client-direct
    //         transition (`entersArchivedState()` blocks it).
    //         Staff: notes-only / updatedAt-only on ASSIGNED tasks.
    // Delete: admin (any state) OR assigned bookkeeper while
    //         status is 'pending' (PRD story 29).
    match /clientFormTasks/{taskId} {

      allow read: if request.auth != null
        && (resource == null
            || resource.data.archived == false
            || isAdmin()
            || request.auth.uid == resource.data.assignedBookkeeperId);
      allow list: if request.auth != null
        && (resource == null
            || resource.data.archived == false
            || isAdmin());

      allow create: if isAdmin() || isBookkeeper();

      allow update: if request.auth != null
        // Slice #10: no client-direct path into the archived state.
        // The archiveTask callable (Admin SDK) owns that transition.
        && !entersArchivedState()
        // Archived rows: admin only.
        && (!isArchived() || isAdmin())
        // Either an admin, OR the assigned bookkeeper under one of
        // the three legal shapes from slice #9, OR a staff user
        // touching only `notes` / `updatedAt` on an assigned task.
        && (
          isAdmin()
          || (
            isAssignedTo()
            && (
              (resource.data.status == "pending"
                  && request.resource.data.status == "pending")
              || isLegalForwardStatus(resource.data.status,
                                      request.resource.data.status)
              || request.resource.data.diff(resource.data)
                    .affectedKeys()
                    .hasOnly(["notes", "updatedAt"])
            )
          )
          || (
            isStaff()
            // Staff may add notes to ANY task — they aren't
            // bookkeeper-scoped. The list of where staff can
            // write is narrowed to `notes` + `updatedAt` below.
            && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(["notes", "updatedAt"])
          )
        );

      allow delete: if request.auth != null
        && (
          isAdmin()
          || (isAssignedTo() && resource.data.status == "pending")
        );

      // ─── Subcollection: encoderNotes/{noteId} ────────────────
      //
      // Staff can add encoder notes to any task (the brief does not
      // constrain it further). Bookkeeper can add encoder notes to
      // their assigned tasks. Admin can write anywhere.
      // Reads follow the same gate as the parent task.
      match /encoderNotes/{noteId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/clientFormTasks/$(taskId)).data.assignedBookkeeperId
              || isAdmin()
              || isBookkeeper());
        allow create: if isAdmin()
          || (isBookkeeper() && request.auth.uid == get(/databases/$(database)/documents/clientFormTasks/$(taskId)).data.assignedBookkeeperId)
          || isStaffEncoderNoteWrite();
        allow update, delete: if isAdmin()
          || (request.auth.uid == resource.data.createdBy);
      }
    }

    // ─── /taskStatusHistory/{historyId} ──────────────────────────
    //
    // Slice #9 audit log. Append-only.
    // Read: admin, OR the assigned bookkeeper of the referenced
    //       task. Other bookkeepers are explicitly DENIED — the
    //       audit log is per-task, not per-role.
    // Create: admin + bookkeeper.
    // Update + delete: DENIED for everyone (isImmutable()).
    match /taskStatusHistory/{historyId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || (
            resource != null
            && request.auth.uid == get(
                /databases/$(database)/documents/clientFormTasks/$(resource.data.taskId)
              ).data.assignedBookkeeperId
          )
        );
      allow create: if isAdmin() || isBookkeeper();
      allow update, delete: if isImmutable();
    }

    // ─── /birHolidays/{year} ─────────────────────────────────────
    //
    // ADR-003 reference data. Read-only for everyone with a role;
    // writes are admin-only (slice #4 seeded via the
    // `seedBirHolidays` callable, which is admin-gated server-side).
    match /birHolidays/{year} {
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ─── Default deny ────────────────────────────────────────────
    //
    // Anything NOT explicitly matched above is denied. The
    // fall-through deny is conservative — if we add a new
    // collection, we must add a matching block above or document
    // the gap.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
