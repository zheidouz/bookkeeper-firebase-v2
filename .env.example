# Set to "true" to point the Firebase SDK at the local emulator suite.
# Leave "false" in production. .env.local (gitignored) carries the real value.
VITE_USE_EMULATOR=false

# Real Firebase web app config — required only when VITE_USE_EMULATOR=false.
# Get these from Firebase Console → Project Settings → Your apps → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=